{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",

  "runtime.version": "Lua 5.1",
  "runtime.path": ["src/?.lua", "tests/?.lua"],

  "workspace.ignoreDir": [".tools", ".build", "out", "mission", ".git"],

  "diagnostics.globals": ["ROOT"],
  "diagnostics.disable": ["discard-returns"]
}
